#!/usr/bin/env bash

# Print how many screen cells each line of stdin takes, one number a line.
#
# Usage: printf '%s\n' 'Отчёт 日本' | screen-cells   # prints 10
# Effects: none.
# Dependencies: sed.
# Settings: SANDBOX_UTF8_LOCALE, a UTF-8 locale to read characters in
#   (C.UTF-8), which tests/support/sandbox.bash sets.
# Exit codes: 0 success,
#   89 SCREEN_CELLS_ERR_INTERNAL: a bug in this script.
# See: tests/support/screen.bash.
#
# How it works:
#   A small oracle, apart from the width table inside cdl.sh,
#   so the two cannot share a mistake. It skips escape sequences,
#   and knows only the scripts that the tests use:
#   combining marks (U+0300..U+036F) take no cells;
#   CJK, kana, Hangul, fullwidth forms and emoji take two;
#   everything else takes one.
#   It runs as a process of its own on purpose:
#   bats traps every command of a test,
#   which makes a loop over characters inside a test crawl.
#
# Version: 1.0.0

readonly SCREEN_CELLS_ERR_INTERNAL=89

#######################################
# End a run that failed where no code planned it: the ERR trap calls it.
# It passes on unchanged a code that main returns, the 141 of a closed pipe,
# and every code of the block of this tool, which a helper has reported.
#
# Arguments:
#   1: The status of the failed command.
#   2: Its line.
#   3: The command.
#######################################
function __internal_error() {
  # In the guard, FUNCNAME holds only this function and the top level:
  # the command that failed there is main, which returned its code.
  if ((${#FUNCNAME[@]} == 2 || $1 == 141 || $1 / 10 == SCREEN_CELLS_ERR_INTERNAL / 10)); then
    exit "$1"
  fi

  printf 'screen-cells: internal error at line %s (status %s): %s\n' \
    "$2" "$1" "$3" >&2

  exit "${SCREEN_CELLS_ERR_INTERNAL}"
}

#######################################
# Report whether a code point is a combining mark.
#
# Arguments:
#   1: Code point.
#######################################
function is_combining() {
  local -ir code="$1"

  ((code >= 0x0300 && code <= 0x036F))
}

#######################################
# Report whether a code point takes two cells.
#
# Arguments:
#   1: Code point.
#######################################
function is_wide() {
  local -ir code="$1"

  ((code >= 0x1100 && code <= 0x115F)) \
    || ((code >= 0x3040 && code <= 0x30FF)) \
    || ((code >= 0x4E00 && code <= 0x9FFF)) \
    || ((code >= 0xAC00 && code <= 0xD7A3)) \
    || ((code >= 0xFF01 && code <= 0xFF60)) \
    || ((code >= 0x1F300 && code <= 0x1FAFF))
}

#######################################
# Count the screen cells of one line of plain text.
#
# Arguments:
#   1: Text without escape sequences.
#
# Outputs:
#   The number of cells to stdout.
#######################################
function count_cells() {
  local -r text="$1"
  local -i cells=0 code index
  local char

  for ((index = 0; index < ${#text}; index++)); do
    char="${text:index:1}"
    printf -v code '%d' "'${char}"

    if is_combining "${code}"; then
      continue
    elif is_wide "${code}"; then
      cells+=2
    else
      cells+=1
    fi
  done

  printf '%d\n' "${cells}"
}

#######################################
# Entry point: count the cells of every line on stdin.
#
# Globals:
#   SANDBOX_UTF8_LOCALE (read).
#######################################
function main() {
  local line

  # Characters, not bytes: bash reads the locale when LC_ALL changes.
  LC_ALL="${SANDBOX_UTF8_LOCALE:-C.UTF-8}"

  # sed only takes the escape sequences out of stdin;
  # a failure of sed would show as missing lines, which the tests catch.
  while IFS= read -r line; do
    count_cells "${line}"
  done < <(LC_ALL=C sed -E $'s#\033\\[[0-?]*[ -/]*[@-~]##g; s#\033\\][^\a\033]*(\a|\033\\\\)##g')
}

# Tests may source this file for its functions; run as a program, it runs main.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  set -o errexit -o nounset -o pipefail -o errtrace
  # The bash 3.2 of macOS has no inherit_errexit,
  # and install-tools.sh runs on it before Homebrew brings another.
  shopt -s inherit_errexit 2>/dev/null || true
  trap '__internal_error "$?" "${LINENO}" "${BASH_COMMAND}"' ERR
  trap 'exit 130' INT
  trap 'exit 143' TERM

  main "$@"
fi

### End
